# DATABASE_URL points at the database the app AND the test suite use. There is
# no separate test database: `npm test` and POST /api/test/reset both run the
# seed, which DELETES every seeded row before recreating it. Never point this at
# anything you care about. (runSeed() refuses to run when NODE_ENV=production.)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
JWT_SECRET="replace-with-a-long-random-string"
NODE_ENV="development"
