# DATABASE_URL is the database the running app uses. POST /api/test/reset runs
# the seed against it, which DELETES every seeded row before recreating it, so
# never point this at anything you care about. (runSeed() refuses to run when
# NODE_ENV=production.)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# TEST_DATABASE_URL is the database `npm test` uses. vitest overrides
# DATABASE_URL with this value for the whole run. prisma/seed.test.ts wipes and
# reseeds it mid-suite, so it must be a database whose contents are disposable —
# a separate Neon branch is the intended setup. If it is unset, the suite falls
# back to DATABASE_URL and destroys that data instead, with a warning.
#
# It does NOT isolate test files from each other: they all share this one
# database within a run, which is why vitest.config.ts sets
# `fileParallelism: false`.
TEST_DATABASE_URL="postgresql://user:password@host/db_test?sslmode=require"
JWT_SECRET="replace-with-a-long-random-string"
NODE_ENV="development"
